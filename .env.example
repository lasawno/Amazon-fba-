# Frontend
VITE_API_URL=http://localhost:8000/api

# Backend
ENVIRONMENT=development
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/amazon_fba_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Amazon Seller Partner API
AMAZON_CLIENT_ID=your_client_id_here
AMAZON_CLIENT_SECRET=your_client_secret_here
AMAZON_REGION=us-east-1
AMAZON_SELLER_ID=your_seller_id_here
AMAZON_MWS_AUTH_TOKEN=your_mws_auth_token_here

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
